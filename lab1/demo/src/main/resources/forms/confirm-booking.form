{
  "schemaVersion": 16,
  "id": "confirm-booking",
  "type": "default",
  "components": [
    {
      "type": "checkbox",
      "key": "bookingConfirmed",
      "label": "Confirm booking",
      "description": "Checked means continue booking. Unchecked means finish through cancellation branch.",
      "validate": {"required": true}
    },
    {
      "type": "textarea",
      "key": "cancelReason",
      "label": "Cancellation reason",
      "description": "Optional. Fill this if booking is not confirmed."
    }
  ]
}
