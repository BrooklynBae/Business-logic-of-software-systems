<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_AirbnbFastBookingLab4"
                  targetNamespace="http://blps-lab4/camunda">
  <bpmn:process id="airbnb-fast-booking"
                name="Airbnb Fast Booking Lab 4"
                isExecutable="true"
                camunda:isStartableInTasklist="true"
                camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_BookingStarted" name="[USER] Start booking" camunda:formRef="start-booking" camunda:formRefBinding="latest">
      <bpmn:outgoing>Flow_Start_SearchForm</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_SearchCriteria" name="[USER] Enter search criteria" camunda:candidateGroups="ROLE_USER" camunda:formRef="search-accommodation" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_Start_SearchForm</bpmn:incoming>
      <bpmn:outgoing>Flow_SearchForm_SearchService</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_SearchAccommodations" name="[SYSTEM] Search accommodations" camunda:type="external" camunda:topic="search-accommodations">
      <bpmn:incoming>Flow_SearchForm_SearchService</bpmn:incoming>
      <bpmn:outgoing>Flow_SearchService_FoundGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_AccommodationFound" name="Accommodation found?">
      <bpmn:incoming>Flow_SearchService_FoundGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Found_Select</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotFound_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_SelectAccommodation" name="[USER] Select accommodation" camunda:candidateGroups="ROLE_USER" camunda:formRef="select-accommodation" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_Found_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_CheckAvailability</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_CheckAvailability" name="[SYSTEM] Check availability" camunda:type="external" camunda:topic="check-availability">
      <bpmn:incoming>Flow_Select_CheckAvailability</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_AvailableGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Available" name="Accommodation available?">
      <bpmn:incoming>Flow_Check_AvailableGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Available_Confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_Unavailable_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ConfirmBooking" name="[USER] Confirm booking request" camunda:candidateGroups="ROLE_USER" camunda:formRef="confirm-booking" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_Available_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_ConfirmedGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_BookingConfirmed" name="bookingConfirmed?">
      <bpmn:incoming>Flow_Confirm_ConfirmedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed_CreateDraft</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotConfirmed_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_CreateDraft" name="[SYSTEM] Create reservation draft" camunda:type="external" camunda:topic="create-reservation-draft">
      <bpmn:incoming>Flow_Confirmed_CreateDraft</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateDraft_AdminModeration</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_AdminModeration" name="[ADMIN] Moderate reservation message" camunda:candidateGroups="ROLE_ADMIN" camunda:formRef="admin-moderate-reservation" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_CreateDraft_AdminModeration</bpmn:incoming>
      <bpmn:outgoing>Flow_AdminModeration_Service</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BoundaryEvent_AdminTimer" name="Draft expired" attachedToRef="UserTask_AdminModeration">
      <bpmn:outgoing>Flow_AdminTimer_CancelExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="ServiceTask_ModerateReservation" name="[SYSTEM] Apply admin moderation" camunda:type="external" camunda:topic="moderate-reservation">
      <bpmn:incoming>Flow_AdminModeration_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Moderate_AdminGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_AdminApproved" name="adminApproved?">
      <bpmn:incoming>Flow_Moderate_AdminGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AdminApproved_OwnerTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_AdminRejected_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_OwnerApproval" name="[OWNER] Approve booking" camunda:candidateGroups="ROLE_OWNER" camunda:formRef="owner-approve-booking" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_AdminApproved_OwnerTask</bpmn:incoming>
      <bpmn:outgoing>Flow_OwnerApproval_Service</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_OwnerConfirmReservation" name="[SYSTEM] Apply owner decision" camunda:type="external" camunda:topic="owner-confirm-reservation">
      <bpmn:incoming>Flow_OwnerApproval_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Owner_ServiceGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_OwnerApproved" name="ownerApproved?">
      <bpmn:incoming>Flow_Owner_ServiceGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OwnerApproved_PaymentTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_OwnerRejected_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_PayReservation" name="[USER] Pay reservation" camunda:candidateGroups="ROLE_USER" camunda:formRef="payment" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_OwnerApproved_PaymentTask</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentTask_PaymentGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_PaymentConfirmed" name="paymentConfirmed?">
      <bpmn:incoming>Flow_PaymentTask_PaymentGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentConfirmed_ProcessPayment</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentCancelled_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_ProcessPayment" name="[SYSTEM] Process payment" camunda:type="external" camunda:topic="process-payment">
      <bpmn:incoming>Flow_PaymentConfirmed_ProcessPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessPayment_CallEis</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_CallEis" name="[SYSTEM] Call EIS adapter" camunda:type="external" camunda:topic="call-eis-adapter">
      <bpmn:incoming>Flow_ProcessPayment_CallEis</bpmn:incoming>
      <bpmn:outgoing>Flow_Eis_SendMessage</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_SendReservationMessage" name="[JMS] Send reservation confirmation message" camunda:type="external" camunda:topic="send-reservation-message">
      <bpmn:incoming>Flow_Eis_SendMessage</bpmn:incoming>
      <bpmn:outgoing>Flow_SendMessage_WaitAsync</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="CatchEvent_AsyncProcessed" name="[JMS] reservation-async-processed">
      <bpmn:incoming>Flow_SendMessage_WaitAsync</bpmn:incoming>
      <bpmn:outgoing>Flow_Async_Finalize</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ReservationAsyncProcessed"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="ServiceTask_FinalizeBooking" name="[SYSTEM] Finalize booking" camunda:type="external" camunda:topic="finalize-booking">
      <bpmn:incoming>Flow_Async_Finalize</bpmn:incoming>
      <bpmn:outgoing>Flow_Finalize_GenerateReport</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_GenerateContractReport" name="[SYSTEM] Generate contract/report" camunda:type="external" camunda:topic="generate-contract-report">
      <bpmn:incoming>Flow_Finalize_GenerateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_Report_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_CancelExpiredDraft" name="[SYSTEM] Cancel expired draft" camunda:type="external" camunda:topic="cancel-expired-draft">
      <bpmn:incoming>Flow_AdminTimer_CancelExpired</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelExpired_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Completed" name="Booking completed">
      <bpmn:incoming>Flow_Report_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_NotFound" name="Accommodation not found">
      <bpmn:incoming>Flow_NotFound_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Unavailable" name="Accommodation unavailable">
      <bpmn:incoming>Flow_Unavailable_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_CancelledByUser" name="Booking cancelled by user">
      <bpmn:incoming>Flow_NotConfirmed_Cancel</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentCancelled_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_RejectedByAdmin" name="Rejected by admin">
      <bpmn:incoming>Flow_AdminRejected_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_RejectedByOwner" name="Rejected by owner">
      <bpmn:incoming>Flow_OwnerRejected_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Expired" name="Draft expired">
      <bpmn:incoming>Flow_CancelExpired_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_SearchForm" sourceRef="StartEvent_BookingStarted" targetRef="UserTask_SearchCriteria"/>
    <bpmn:sequenceFlow id="Flow_SearchForm_SearchService" sourceRef="UserTask_SearchCriteria" targetRef="ServiceTask_SearchAccommodations"/>
    <bpmn:sequenceFlow id="Flow_SearchService_FoundGateway" sourceRef="ServiceTask_SearchAccommodations" targetRef="Gateway_AccommodationFound"/>
    <bpmn:sequenceFlow id="Flow_Found_Select" sourceRef="Gateway_AccommodationFound" targetRef="UserTask_SelectAccommodation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accommodationFound == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotFound_End" sourceRef="Gateway_AccommodationFound" targetRef="EndEvent_NotFound">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accommodationFound == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Select_CheckAvailability" sourceRef="UserTask_SelectAccommodation" targetRef="ServiceTask_CheckAvailability"/>
    <bpmn:sequenceFlow id="Flow_Check_AvailableGateway" sourceRef="ServiceTask_CheckAvailability" targetRef="Gateway_Available"/>
    <bpmn:sequenceFlow id="Flow_Available_Confirm" sourceRef="Gateway_Available" targetRef="UserTask_ConfirmBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${available == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Unavailable_End" sourceRef="Gateway_Available" targetRef="EndEvent_Unavailable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${available == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Confirm_ConfirmedGateway" sourceRef="UserTask_ConfirmBooking" targetRef="Gateway_BookingConfirmed"/>
    <bpmn:sequenceFlow id="Flow_Confirmed_CreateDraft" sourceRef="Gateway_BookingConfirmed" targetRef="ServiceTask_CreateDraft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bookingConfirmed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotConfirmed_Cancel" sourceRef="Gateway_BookingConfirmed" targetRef="EndEvent_CancelledByUser">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bookingConfirmed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CreateDraft_AdminModeration" sourceRef="ServiceTask_CreateDraft" targetRef="UserTask_AdminModeration"/>
    <bpmn:sequenceFlow id="Flow_AdminModeration_Service" sourceRef="UserTask_AdminModeration" targetRef="ServiceTask_ModerateReservation"/>
    <bpmn:sequenceFlow id="Flow_AdminTimer_CancelExpired" sourceRef="BoundaryEvent_AdminTimer" targetRef="ServiceTask_CancelExpiredDraft"/>
    <bpmn:sequenceFlow id="Flow_Moderate_AdminGateway" sourceRef="ServiceTask_ModerateReservation" targetRef="Gateway_AdminApproved"/>
    <bpmn:sequenceFlow id="Flow_AdminApproved_OwnerTask" sourceRef="Gateway_AdminApproved" targetRef="UserTask_OwnerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adminApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AdminRejected_End" sourceRef="Gateway_AdminApproved" targetRef="EndEvent_RejectedByAdmin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adminApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OwnerApproval_Service" sourceRef="UserTask_OwnerApproval" targetRef="ServiceTask_OwnerConfirmReservation"/>
    <bpmn:sequenceFlow id="Flow_Owner_ServiceGateway" sourceRef="ServiceTask_OwnerConfirmReservation" targetRef="Gateway_OwnerApproved"/>
    <bpmn:sequenceFlow id="Flow_OwnerApproved_PaymentTask" sourceRef="Gateway_OwnerApproved" targetRef="UserTask_PayReservation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ownerApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OwnerRejected_End" sourceRef="Gateway_OwnerApproved" targetRef="EndEvent_RejectedByOwner">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ownerApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentTask_PaymentGateway" sourceRef="UserTask_PayReservation" targetRef="Gateway_PaymentConfirmed"/>
    <bpmn:sequenceFlow id="Flow_PaymentConfirmed_ProcessPayment" sourceRef="Gateway_PaymentConfirmed" targetRef="ServiceTask_ProcessPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentConfirmed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentCancelled_End" sourceRef="Gateway_PaymentConfirmed" targetRef="EndEvent_CancelledByUser">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentConfirmed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ProcessPayment_CallEis" sourceRef="ServiceTask_ProcessPayment" targetRef="ServiceTask_CallEis"/>
    <bpmn:sequenceFlow id="Flow_Eis_SendMessage" sourceRef="ServiceTask_CallEis" targetRef="ServiceTask_SendReservationMessage"/>
    <bpmn:sequenceFlow id="Flow_SendMessage_WaitAsync" sourceRef="ServiceTask_SendReservationMessage" targetRef="CatchEvent_AsyncProcessed"/>
    <bpmn:sequenceFlow id="Flow_Async_Finalize" sourceRef="CatchEvent_AsyncProcessed" targetRef="ServiceTask_FinalizeBooking"/>
    <bpmn:sequenceFlow id="Flow_Finalize_GenerateReport" sourceRef="ServiceTask_FinalizeBooking" targetRef="ServiceTask_GenerateContractReport"/>
    <bpmn:sequenceFlow id="Flow_Report_End" sourceRef="ServiceTask_GenerateContractReport" targetRef="EndEvent_Completed"/>
    <bpmn:sequenceFlow id="Flow_CancelExpired_End" sourceRef="ServiceTask_CancelExpiredDraft" targetRef="EndEvent_Expired"/>
  </bpmn:process>

  <bpmn:message id="Message_ReservationAsyncProcessed" name="reservation-async-processed"/>
</bpmn:definitions>
